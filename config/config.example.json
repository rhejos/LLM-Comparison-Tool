  "analysis": {
    "bias_detection": {
      "enabled": true,
      "categories": [
        "gender",
        "race",
        "political",
        "age",
        "religion",
        "socioeconomic"
      ]
    },
    "discrepancy_detection": {
      "enabled": true,
      "similarity_threshold": 0.85
    },
    "topic_analysis": {
      "enabled": true,
      "categories": [
        "creative_writing",
        "technical_explanation",
        "factual_research",
        "code_generation",
        "mathematical_reasoning",
        "conversational",
        "analytical"
      ]
    },
    "hallucination_detection": {
      "enabled": true,
      "confidence_threshold": 0.7
    }
  },
  "metrics": {
    "quality": {
      "coherence_weight": 0.3,
      "relevance_weight": 0.3,
      "completeness_weight": 0.2,
      "clarity_weight": 0.2
    },
    "consistency": {
      "repetition_count": 3,
      "similarity_threshold": 0.8
    }
  },
  "reporting": {
    "output_formats": ["markdown", "json", "html"],
    "include_visualizations": true,
    "detailed_analysis": true
  },
  "rate_limiting": {
    "requests_per_minute": 50,
    "retry_attempts": 3,
    "retry_delay": 2
  }
}
